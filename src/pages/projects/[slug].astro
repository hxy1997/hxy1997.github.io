---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <section class="section-space pt-2">
    <article class="panel panel-strong rounded-[36px] border border-slate-200/80 p-8 dark:border-white/10 md:p-10">
      <p class="eyebrow">Project Detail</p>
      <div class="mt-5 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="font-display text-4xl font-semibold tracking-tight text-[var(--text-main)] md:text-5xl">
            {project.data.title}
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--text-muted)]">{project.data.summary}</p>
        </div>
        <div class="grid gap-3 text-sm text-[var(--text-soft)] sm:grid-cols-3 lg:text-right">
          <div>
            <p>时间</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{project.data.period}</p>
          </div>
          <div>
            <p>角色</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{project.data.role}</p>
          </div>
          <div>
            <p>状态</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{project.data.status}</p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        {project.data.stack.map((item) => (
          <span class="chip rounded-full">{item}</span>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        {project.data.demoUrl && (
          <a class="button-primary" href={project.data.demoUrl} target="_blank" rel="noreferrer">查看演示</a>
        )}
        {project.data.repoUrl && (
          <a class="button-secondary" href={project.data.repoUrl} target="_blank" rel="noreferrer">查看仓库</a>
        )}
      </div>
    </article>
  </section>

  <section class="section-space pt-0">
    <article class="panel rounded-[36px] border border-slate-200/80 p-8 dark:border-white/10 md:p-10">
      <div class="rich-text">
        <Content />
      </div>
    </article>
  </section>
</BaseLayout>