---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout title="简历" description="在线简历页面，概览我的方向、经验与技术栈。">
  <section class="section-space pt-2">
    <article class="panel panel-strong rounded-[36px] border border-slate-200/80 p-8 dark:border-white/10 md:p-10">
      <p class="eyebrow">Resume</p>
      <div class="mt-5 grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
        <div>
          <h1 class="font-display text-4xl font-semibold tracking-tight text-[var(--text-main)] md:text-5xl">
            {siteConfig.name}
          </h1>
          <p class="mt-4 text-lg text-[var(--text-muted)]">{siteConfig.title}</p>
          <p class="mt-6 max-w-3xl text-base leading-8 text-[var(--text-muted)]">{siteConfig.resume.summary}</p>
        </div>
        <div class="grid gap-3 text-sm text-[var(--text-soft)] sm:grid-cols-2 lg:text-right">
          <div>
            <p>城市</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{siteConfig.location}</p>
          </div>
          <div>
            <p>状态</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{siteConfig.status}</p>
          </div>
          <div>
            <p>邮箱</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{siteConfig.email}</p>
          </div>
          <div>
            <p>GitHub</p>
            <p class="mt-2 text-base text-[var(--text-main)]">{siteConfig.github}</p>
          </div>
        </div>
      </div>
    </article>
  </section>

  <section class="section-space pt-0">
    <div class="grid gap-6 lg:grid-cols-[0.92fr_1.08fr]">
      <div class="panel rounded-[32px] border border-slate-200/80 p-8 dark:border-white/10 md:p-9">
        <p class="eyebrow">技术栈</p>
        <div class="mt-6 grid gap-4">
          {siteConfig.resume.stacks.map((group) => (
            <section class="rounded-[26px] border border-slate-200/80 p-5 dark:border-white/10">
              <h2 class="font-display text-xl text-[var(--text-main)]">{group.group}</h2>
              <div class="mt-4 flex flex-wrap gap-3">
                {group.items.map((item) => (
                  <span class="chip rounded-full">{item}</span>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <div class="panel rounded-[32px] border border-slate-200/80 p-8 dark:border-white/10 md:p-9">
        <p class="eyebrow">经历概览</p>
        <div class="mt-6 grid gap-5">
          {siteConfig.experience.map((item) => (
            <article class="rounded-[28px] border border-slate-200/80 p-6 dark:border-white/10">
              <p class="text-sm text-[var(--text-soft)]">{item.period}</p>
              <h2 class="mt-3 font-display text-2xl text-[var(--text-main)]">{item.title}</h2>
              <p class="mt-4 text-base leading-8 text-[var(--text-muted)]">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
