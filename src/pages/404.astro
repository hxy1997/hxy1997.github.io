---
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。">
  <section class="section-space pt-8">
    <div class="panel panel-strong rounded-[36px] border border-slate-200/80 p-10 text-center dark:border-white/10">
      <p class="eyebrow">404</p>
      <h1 class="mt-5 font-display text-4xl font-semibold text-[var(--text-main)]">页面未找到</h1>
      <p class="mt-5 text-base leading-8 text-[var(--text-muted)]">你访问的页面不存在，或者链接已经调整。</p>
      <div class="mt-8">
        <a href={baseUrl} class="button-primary">返回首页</a>
      </div>
    </div>
  </section>
</BaseLayout>