---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../data/site";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPosts = posts.slice(0, 3);
const featuredProjects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .slice(0, 2);
const heroSkills = siteConfig.skills.slice(0, 5);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="首页" description={siteConfig.description}>
  <section class="section-space pt-2">
    <div class="panel panel-strong grid-frost rounded-[40px] border border-[color:var(--panel-border)] p-8 md:p-10">
      <div class="hero-orbit" aria-hidden="true">
        <span class="hero-orbit-dot hero-orbit-dot-primary"></span>
        <span class="hero-orbit-dot hero-orbit-dot-secondary"></span>
        <span class="hero-orbit-line"></span>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
        <div>
          <p class="eyebrow">About me</p>
          <div class="mt-6 space-y-5">
            <div class="space-y-4">
              <h1 class="font-display text-5xl font-semibold leading-[1.04] text-[var(--text-main)] md:text-7xl">
                {siteConfig.name}
              </h1>
              <p class="max-w-xl text-lg leading-8 text-[var(--text-muted)] md:text-[1.35rem] md:leading-9">
                {siteConfig.tagline}
              </p>
            </div>
            <p class="max-w-2xl text-base leading-8 text-[var(--text-muted)]">
              常驻 {siteConfig.location}，关注个人品牌站、内容系统和体验细节。希望把克制的设计和清晰的工程结构放到同一个站里。
            </p>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <div class="rounded-[26px] border border-[color:var(--panel-border)] bg-white/30 p-5 dark:bg-white/4">
              <p class="text-sm text-[var(--text-soft)]">职业方向</p>
              <p class="mt-3 font-display text-xl leading-8 text-[var(--text-main)]">{siteConfig.title}</p>
            </div>
            <div class="rounded-[26px] border border-[color:var(--panel-border)] bg-white/30 p-5 dark:bg-white/4">
              <p class="text-sm text-[var(--text-soft)]">当前状态</p>
              <p class="mt-3 font-display text-xl leading-8 text-[var(--text-main)]">{siteConfig.status}</p>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            {heroSkills.map((skill) => (
              <span class="chip rounded-full">{skill}</span>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a href={`${baseUrl}projects/`} class="button-primary">
              <svg class="button-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H10l2 2h5.5A2.5 2.5 0 0 1 20 9.5v8A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5z"></path>
                <path d="M8 11h8"></path>
              </svg>
              查看项目
            </a>
            <a href={`${baseUrl}about/`} class="button-secondary">
              <svg class="button-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="8"></circle>
                <path d="M12 10.5v5"></path>
                <path d="M12 7.5h.01"></path>
              </svg>
              了解更多
            </a>
          </div>
        </div>

        <div class="grid gap-3">
          {featuredProjects.map((project) => (
            <a href={`${baseUrl}projects/${project.slug}/`} class="hero-stack-card">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <p class="text-sm text-[var(--text-soft)]">{project.data.period}</p>
                  <h2 class="mt-2 font-display text-2xl leading-tight text-[var(--text-main)]">{project.data.title}</h2>
                </div>
                <span class="badge-pill">{project.data.status}</span>
              </div>
              <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">{project.data.summary}</p>
            </a>
          ))}
          <div class="rounded-[28px] border border-dashed border-[color:var(--panel-border)] bg-white/18 p-5 dark:bg-white/3">
            <p class="text-sm text-[var(--text-soft)]">阅读与内容</p>
            <p class="mt-3 font-display text-2xl leading-tight text-[var(--text-main)]">最近写了 {featuredPosts.length} 篇方法笔记</p>
            <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">
              首页不再展开完整预览，想继续读的话，直接进入博客页更干净。
            </p>
            <a href={`${baseUrl}blog/`} class="hero-link">进入博客 <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <SectionHeading
      eyebrow="Selected work"
      title="最近值得先看的两个项目"
      description="首页只留两个精选项目，完整项目列表交给项目页继续展开。"
      actionHref="/projects"
      actionLabel="查看全部项目"
    />
    <div class="grid gap-6 lg:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section-space pt-0">
    <SectionHeading
      eyebrow="Recent notes"
      title="最近写下的三篇文章"
      description="把博客入口控制在刚刚好的密度，既能传达内容感，也不把首页变成文章列表页。"
      actionHref="/blog"
      actionLabel="进入博客"
    />
    <div class="grid gap-6 lg:grid-cols-3">
      {featuredPosts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="panel panel-strong rounded-[36px] border border-[color:var(--panel-border)] p-8 md:p-10">
      <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="eyebrow">Contact</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight text-[var(--text-main)] md:text-4xl">
            想继续了解我，或者直接聊合作，也可以从这里进入
          </h2>
          <p class="mt-5 max-w-2xl text-base leading-8 text-[var(--text-muted)]">
            关于我、简历和联系方式都已经单独整理好了。首页只负责留下一个清楚的第一印象，后面的内容交给更合适的页面承接。
          </p>
        </div>
        <div class="flex flex-wrap gap-4 lg:justify-end">
          <a href={`${baseUrl}contact/`} class="button-primary">联系我</a>
          <a href={`${baseUrl}resume/`} class="button-secondary">查看简历</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>