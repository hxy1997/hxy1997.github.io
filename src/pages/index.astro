---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCard from "../components/ContactCard.astro";
import { siteConfig } from "../data/site";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);
const heroPost = latestPosts[0];
const sidePosts = latestPosts.slice(1);
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .slice(0, 3);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="首页" description={siteConfig.description}>
  <section class="section-space pt-2">
    <div class="grid gap-6 lg:grid-cols-[1.08fr_0.92fr]">
      <div class="panel panel-strong grid-frost rounded-[40px] border border-[color:var(--panel-border)] p-8 md:p-10">
        <p class="eyebrow">About me</p>
        <div class="mt-6 space-y-5">
          <div class="space-y-3">
            <h1 class="font-display text-5xl font-semibold leading-[1.05] text-[var(--text-main)] md:text-7xl">
              {siteConfig.name}
            </h1>
            <p class="max-w-xl text-lg leading-8 text-[var(--text-muted)] md:text-[1.35rem] md:leading-9">
              {siteConfig.tagline}
            </p>
          </div>
          <p class="max-w-2xl text-base leading-8 text-[var(--text-muted)]">{siteConfig.intro}</p>
        </div>

        <div class="mt-9 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <div class="panel rounded-[28px] border border-[color:var(--panel-border)] p-5">
            <p class="text-sm text-[var(--text-soft)]">职业方向</p>
            <p class="mt-3 font-display text-xl leading-9 text-[var(--text-main)]">{siteConfig.title}</p>
          </div>
          <div class="panel rounded-[28px] border border-[color:var(--panel-border)] p-5">
            <p class="text-sm text-[var(--text-soft)]">所在城市</p>
            <p class="mt-3 font-display text-xl leading-9 text-[var(--text-main)]">{siteConfig.location}</p>
          </div>
          <div class="panel rounded-[28px] border border-[color:var(--panel-border)] p-5 sm:col-span-2 xl:col-span-1">
            <p class="text-sm text-[var(--text-soft)]">当前状态</p>
            <p class="mt-3 font-display text-xl leading-9 text-[var(--text-main)]">{siteConfig.status}</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {siteConfig.skills.map((skill) => (
            <span class="chip rounded-full">{skill}</span>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href={`${baseUrl}projects/`} class="button-primary">
            <svg class="button-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H10l2 2h5.5A2.5 2.5 0 0 1 20 9.5v8A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5z"></path>
              <path d="M8 11h8"></path>
            </svg>
            查看项目
          </a>
          <a href={`${baseUrl}contact/`} class="button-secondary">
            <svg class="button-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5z"></path>
              <path d="m6 8 6 4 6-4"></path>
            </svg>
            联系我
          </a>
        </div>

        <div class="mt-10 grid gap-4 border-t border-[color:var(--panel-border)] pt-8 md:grid-cols-3">
          {siteConfig.stats.map((item) => (
            <div>
              <p class="text-sm text-[var(--text-soft)]">{item.label}</p>
              <p class="mt-2 font-display text-2xl text-[var(--text-main)]">{item.value}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid gap-4">
        {heroPost && <BlogCard post={heroPost} featured />}
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-1">
          {sidePosts.map((post) => <BlogCard post={post} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <SectionHeading
      eyebrow="Selected work"
      title="近期做过的项目与作品"
      description="项目区保持卡片化的信息密度，鼠标停留时只给轻微反馈，让画面依旧干净，不显得过度炫技。"
      actionHref="/projects"
      actionLabel="查看全部项目"
    />
    <div class="grid gap-6 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section-space pt-0">
    <SectionHeading
      eyebrow="Recent notes"
      title="最近写下的笔记与文章"
      description="首页保留简短的阅读入口，正文继续由 Markdown 管理，方便你长期写作和持续扩展。"
      actionHref="/blog"
      actionLabel="进入博客"
    />
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {latestPosts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="panel rounded-[34px] border border-[color:var(--panel-border)] p-8 md:p-9">
        <p class="eyebrow">About</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight text-[var(--text-main)] md:text-4xl">
          把主页做成一个会慢慢生长的个人刊物
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-[var(--text-muted)]">
          我希望这个站点既能承载作品，也能放下正在形成中的想法。视觉上保持轻和克制，结构上尽量清楚，方便之后继续写、继续补、继续长。
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {siteConfig.highlights.map((item) => (
            <div class="rounded-[28px] border border-[color:var(--panel-border)] bg-white/32 p-5 dark:bg-white/4">
              <h3 class="font-display text-xl leading-8 text-[var(--text-main)]">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>