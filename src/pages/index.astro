---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCard from "../components/ContactCard.astro";
import { siteConfig } from "../data/site";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 4);
const heroPost = latestPosts[0];
const sidePosts = latestPosts.slice(1);
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .slice(0, 3);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="首页" description={siteConfig.description}>
  <section class="section-space pt-2">
    <div class="grid gap-6 lg:grid-cols-[1.08fr_0.92fr]">
      <div class="panel panel-strong grid-frost rounded-[36px] border border-slate-200/80 p-8 dark:border-white/10 md:p-10">
        <p class="eyebrow">About me</p>
        <div class="mt-6 space-y-5">
          <div class="space-y-3">
            <h1 class="font-display text-4xl font-semibold tracking-tight text-[var(--text-main)] md:text-6xl md:leading-[1.04]">
              {siteConfig.name}
            </h1>
            <p class="max-w-xl text-lg leading-8 text-[var(--text-muted)] md:text-xl">
              {siteConfig.tagline}
            </p>
          </div>
          <p class="max-w-2xl text-base leading-8 text-[var(--text-muted)]">{siteConfig.intro}</p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <div class="panel rounded-[26px] border border-slate-200/80 p-5 dark:border-white/10">
            <p class="text-sm text-[var(--text-soft)]">职业方向</p>
            <p class="mt-3 font-display text-lg text-[var(--text-main)]">{siteConfig.title}</p>
          </div>
          <div class="panel rounded-[26px] border border-slate-200/80 p-5 dark:border-white/10">
            <p class="text-sm text-[var(--text-soft)]">所在城市</p>
            <p class="mt-3 font-display text-lg text-[var(--text-main)]">{siteConfig.location}</p>
          </div>
          <div class="panel rounded-[26px] border border-slate-200/80 p-5 sm:col-span-2 xl:col-span-1 dark:border-white/10">
            <p class="text-sm text-[var(--text-soft)]">当前状态</p>
            <p class="mt-3 font-display text-lg text-[var(--text-main)]">{siteConfig.status}</p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {siteConfig.skills.map((skill) => (
            <span class="chip rounded-full">{skill}</span>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href={`${baseUrl}projects/`} class="button-primary">查看项目</a>
          <a href={`${baseUrl}contact/`} class="button-secondary">联系我</a>
        </div>

        <div class="mt-10 grid gap-4 border-t border-slate-200/70 pt-8 dark:border-white/10 md:grid-cols-3">
          {siteConfig.stats.map((item) => (
            <div>
              <p class="text-sm text-[var(--text-soft)]">{item.label}</p>
              <p class="mt-2 font-display text-2xl text-[var(--text-main)]">{item.value}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid gap-4">
        {heroPost && <BlogCard post={heroPost} featured />}
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-1">
          {sidePosts.map((post) => <BlogCard post={post} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section-space pt-0">
    <SectionHeading
      eyebrow="精选项目"
      title="近期做过的项目与作品"
      description="项目列表采用卡片化信息密度，悬停时提供轻微反馈，点击进入完整详情页。"
      actionHref="/projects"
      actionLabel="查看全部项目"
    />
    <div class="grid gap-6 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section-space pt-0">
    <SectionHeading
      eyebrow="最新博客"
      title="最近写下的笔记与文章"
      description="首页保留缩略列表，正文内容全部由 Markdown 管理，方便你后续持续写作。"
      actionHref="/blog"
      actionLabel="进入博客"
    />
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {latestPosts.map((post) => <BlogCard post={post} />)}
    </div>
  </section>

  <section class="section-space pt-0">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="panel rounded-[32px] border border-slate-200/80 p-8 dark:border-white/10 md:p-9">
        <p class="eyebrow">关于我</p>
        <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-[var(--text-main)] md:text-4xl">
          把个人主页做成一个持续更新的内容空间
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-[var(--text-muted)]">
          我希望这个网站同时承载作品展示、博客写作、简历信息和联系方式。视觉上保持克制，结构上尽量清楚，长期维护时也不会变成负担。
        </p>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {siteConfig.highlights.map((item) => (
            <div class="rounded-[26px] border border-slate-200/80 p-5 dark:border-white/10">
              <h3 class="font-display text-xl text-[var(--text-main)]">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--text-muted)]">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>