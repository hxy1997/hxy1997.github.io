---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../data/site";
--- <BaseLayout title="关于" description="关于我的工作方式、项目偏好和内容方向。"> <section class="section-space pt-2"> <div class="panel panel-strong rounded-[36px] border border-[color:var(--panel-border)] p-8 md:p-10"> <p class="eyebrow">About</p> <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight text-[var(--text-main)] md:text-5xl"> 我关注长期可维护的界面、内容和工程结构 </h1> <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--text-muted)]"> 我偏爱把一个站点拆成明确的信息架构，再用温和但不无聊的视觉系统把它组织起来。这个个人主页本身就是这种思路的实践样例。 </p> </div> </section> <section class="section-space pt-0"> <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]"> <div class="panel rounded-[32px] border border-[color:var(--panel-border)] p-8 md:p-9"> <p class="eyebrow">工作原则</p> <div class="mt-6 grid gap-4"> {siteConfig.principles.map((item, index) => ( <div class="rounded-[26px] border border-[color:var(--panel-border)] p-5 "> <p class="text-sm text-[var(--text-soft)]">0{index + 1}</p> <p class="mt-3 text-lg leading-8 text-[var(--text-main)]">{item}</p> </div> ))} </div> </div> <div class="panel rounded-[32px] border border-[color:var(--panel-border)] p-8 md:p-9"> <p class="eyebrow">技能标签</p> <div class="mt-6 flex flex-wrap gap-3"> {siteConfig.skills.map((skill) => ( <span class="chip rounded-full">{skill}</span> ))} </div> <div class="mt-8 rounded-[28px] border border-dashed border-[color:var(--panel-border)] p-6 "> <p class="text-sm text-[var(--text-soft)]">当前状态</p> <p class="mt-3 font-display text-2xl text-[var(--text-main)]">{siteConfig.status}</p> <p class="mt-4 text-sm leading-7 text-[var(--text-muted)]"> 如果你在做个人品牌站、内容型网站、作品集改版或前端工程优化，这类合作会比较契合我的经验边界。 </p> </div> </div> </div> </section> <section class="section-space pt-0"> <div class="panel rounded-[32px] border border-[color:var(--panel-border)] p-8 md:p-9"> <p class="eyebrow">经历</p> <div class="mt-6 grid gap-5"> {siteConfig.experience.map((item) => ( <article class="rounded-[28px] border border-[color:var(--panel-border)] p-6 "> <p class="text-sm text-[var(--text-soft)]">{item.period}</p> <h2 class="mt-3 font-display text-2xl text-[var(--text-main)]">{item.title}</h2> <p class="mt-4 max-w-3xl text-base leading-8 text-[var(--text-muted)]">{item.body}</p> </article> ))} </div> </div> </section>
</BaseLayout> 