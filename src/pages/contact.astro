---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactCard from "../components/ContactCard.astro";
import { siteConfig } from "../data/site";
---

<BaseLayout title="联系" description="通过邮箱、GitHub 或微信联系我。">
  <section class="section-space pt-2">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="panel panel-strong rounded-[36px] border border-slate-200/80 p-8 dark:border-white/10 md:p-10">
        <p class="eyebrow">Contact</p>
        <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight text-[var(--text-main)] md:text-5xl">
          如果你有合适的合作方向，可以直接联系我
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--text-muted)]">
          当前优先关注个人品牌站、内容系统、前端重构和一些需要兼顾视觉与工程质量的 Web 项目。
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          <div class="rounded-[26px] border border-slate-200/80 p-5 dark:border-white/10">
            <p class="text-sm text-[var(--text-soft)]">邮箱</p>
            <p class="mt-3 break-all text-base text-[var(--text-main)]">{siteConfig.email}</p>
          </div>
          <div class="rounded-[26px] border border-slate-200/80 p-5 dark:border-white/10">
            <p class="text-sm text-[var(--text-soft)]">GitHub</p>
            <p class="mt-3 break-all text-base text-[var(--text-main)]">{siteConfig.github}</p>
          </div>
          <div class="rounded-[26px] border border-dashed border-slate-200/80 p-5 dark:border-white/10">
            <p class="text-sm text-[var(--text-soft)]">微信</p>
            <p class="mt-3 text-base text-[var(--text-main)]">{siteConfig.wechat}</p>
          </div>
        </div>
      </div>
      <ContactCard />
    </div>
  </section>
</BaseLayout>
