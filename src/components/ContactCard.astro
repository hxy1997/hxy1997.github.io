---
import { siteConfig } from "../data/site";
---

<div class="panel rounded-[32px] border border-slate-200/80 p-7 dark:border-white/10">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">保持联系</p>
      <h3 class="mt-3 font-display text-2xl font-semibold text-[var(--text-main)]">邮箱 / GitHub / 微信</h3>
    </div>
    <span class="rounded-full border border-slate-200/80 px-3 py-1 text-xs text-[var(--text-soft)] dark:border-white/10">Contact</span>
  </div>
  <div class="mt-6 grid gap-4 text-sm text-[var(--text-muted)]">
    <a class="rounded-2xl border border-slate-200/80 px-4 py-4 transition hover:border-[color:var(--button-main)] hover:text-[color:var(--button-main)] dark:border-white/10" href={`mailto:${siteConfig.email}`}>
      {siteConfig.email}
    </a>
    <a class="rounded-2xl border border-slate-200/80 px-4 py-4 transition hover:border-[color:var(--button-main)] hover:text-[color:var(--button-main)] dark:border-white/10" href={siteConfig.github} target="_blank" rel="noreferrer">
      {siteConfig.github}
    </a>
    <div class="rounded-2xl border border-dashed border-slate-200/80 px-4 py-4 text-[var(--text-soft)] dark:border-white/10">
      微信：{siteConfig.wechat}
    </div>
  </div>
</div>
