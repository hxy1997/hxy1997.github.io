---
import { siteConfig } from "../data/site";
---

<div class="panel rounded-[32px] border border-[color:var(--panel-border)] p-7 md:p-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="eyebrow">Stay in touch</p>
      <h3 class="mt-3 font-display text-2xl font-semibold text-[var(--text-main)]">邮箱 / GitHub / 微信</h3>
    </div>
    <span class="rounded-full border border-[color:var(--panel-border)] bg-white/40 px-3 py-1 text-xs text-[var(--text-soft)] dark:bg-white/8">Contact</span>
  </div>

  <div class="mt-6 grid gap-4 text-sm text-[var(--text-muted)]">
    <a class="rounded-[24px] border border-[color:var(--panel-border)] bg-white/38 px-4 py-4 transition hover:border-[color:var(--button-main)] hover:text-[color:var(--button-main-hover)] dark:bg-white/4" href={`mailto:${siteConfig.email}`}>
      {siteConfig.email}
    </a>
    <a class="rounded-[24px] border border-[color:var(--panel-border)] bg-white/38 px-4 py-4 transition hover:border-[color:var(--button-main)] hover:text-[color:var(--button-main-hover)] dark:bg-white/4" href={siteConfig.github} target="_blank" rel="noreferrer">
      {siteConfig.github}
    </a>
    <div class="rounded-[24px] border border-dashed border-[color:var(--panel-border)] bg-white/30 px-4 py-4 text-[var(--text-soft)] dark:bg-white/3">
      微信：{siteConfig.wechat}
    </div>
  </div>
</div>