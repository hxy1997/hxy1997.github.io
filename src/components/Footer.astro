---
import { siteConfig } from "../data/site";
---

<footer class="shell pb-12 pt-4">
  <div class="panel rounded-[32px] border border-slate-200/80 px-6 py-5 dark:border-white/10 md:px-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="font-display text-lg font-semibold text-[var(--text-main)]">{siteConfig.name}</p>
        <p class="mt-2 text-sm leading-7 text-[var(--text-muted)]">{siteConfig.description}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--text-soft)]">
        <a href={`mailto:${siteConfig.email}`} class="transition hover:text-[color:var(--button-main)]">Email</a>
        <a href={siteConfig.github} target="_blank" rel="noreferrer" class="transition hover:text-[color:var(--button-main)]">GitHub</a>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </div>
  </div>
</footer>
