---
interface Props {
  project: import("astro:content").CollectionEntry<"projects">;
}

const { project } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const href = `${baseUrl}projects/${project.slug}/`;
---

<article class="group panel rounded-[32px] border border-[color:var(--panel-border)] p-6 transition duration-200 hover:-translate-y-1 hover:border-[color:var(--button-main)] hover:shadow-lg">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-3">
      <p class="text-sm font-medium text-[var(--text-soft)]">{project.data.period}</p>
      <h3 class="font-display text-[1.75rem] font-semibold leading-[1.2] text-[var(--text-main)] transition duration-200 group-hover:text-[color:var(--button-main-hover)]">
        {project.data.title}
      </h3>
    </div>
    <span class="rounded-full border border-[color:var(--panel-border)] bg-white/45 px-3 py-1 text-xs font-medium text-[var(--text-soft)] dark:bg-white/8">
      {project.data.status}
    </span>
  </div>

  <p class="mt-5 text-base leading-8 text-[var(--text-muted)]">{project.data.summary}</p>

  <div class="mt-6 flex flex-wrap gap-2">
    {project.data.stack.map((item) => (
      <span class="chip rounded-full">{item}</span>
    ))}
  </div>

  <div class="mt-7 flex items-center justify-between gap-4">
    <p class="text-sm text-[var(--text-soft)]">{project.data.role}</p>
    <a href={href} class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--button-main-hover)] transition duration-200 group-hover:gap-3">
      查看详情
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>