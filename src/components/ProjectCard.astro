---
interface Props {
  project: import("astro:content").CollectionEntry<"projects">;
}

const { project } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const href = `${baseUrl}projects/${project.slug}/`;
---

<article class="group relative overflow-hidden panel rounded-[32px] border border-[color:var(--panel-border)] p-6 transition duration-200 hover:-translate-y-1 hover:border-[color:var(--button-main)] hover:shadow-lg">
  <div aria-hidden="true" class="pointer-events-none absolute -right-8 top-10 h-20 w-20 rounded-full bg-[color:var(--button-main)]/10 blur-3xl"></div>

  <div class="relative flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1 space-y-3">
      <p class="text-sm font-medium text-[var(--text-soft)]">{project.data.period}</p>
      <h3 class="font-display text-[1.75rem] font-semibold leading-[1.2] text-[var(--text-main)] transition duration-200 group-hover:text-[color:var(--button-main-hover)]">
        {project.data.title}
      </h3>
    </div>
    <span class="badge-pill">
      {project.data.status}
    </span>
  </div>

  <p class="relative mt-5 text-base leading-8 text-[var(--text-muted)]">{project.data.summary}</p>

  <div class="relative mt-6 flex flex-wrap gap-2">
    {project.data.stack.map((item) => (
      <span class="chip rounded-full">{item}</span>
    ))}
  </div>

  <div class="relative mt-7 flex items-center justify-between gap-4">
    <p class="text-sm text-[var(--text-soft)]">{project.data.role}</p>
    <a href={href} class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--button-main-hover)] transition duration-200 group-hover:gap-3">
      查看详情
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>