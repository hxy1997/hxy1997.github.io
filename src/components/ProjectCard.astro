---
interface Props {
  project: import("astro:content").CollectionEntry<"projects">;
}

const { project } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const href = `${baseUrl}projects/${project.slug}/`;
---

<article class="group panel rounded-[30px] border border-slate-200/80 p-6 transition duration-200 hover:-translate-y-1 hover:border-[color:var(--button-main)] hover:shadow-lg dark:border-white/10">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-3">
      <p class="text-sm font-medium text-[var(--text-soft)]">{project.data.period}</p>
      <h3 class="font-display text-2xl font-semibold tracking-tight text-[var(--text-main)] transition duration-200 group-hover:text-[color:var(--button-main)]">
        {project.data.title}
      </h3>
    </div>
    <span class="rounded-full border border-slate-200/80 px-3 py-1 text-xs font-medium text-[var(--text-soft)] dark:border-white/10">
      {project.data.status}
    </span>
  </div>
  <p class="mt-5 text-base leading-7 text-[var(--text-muted)]">{project.data.summary}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {project.data.stack.map((item) => (
      <span class="chip rounded-full">{item}</span>
    ))}
  </div>
  <div class="mt-7 flex items-center justify-between gap-4">
    <p class="text-sm text-[var(--text-soft)]">{project.data.role}</p>
    <a href={href} class="inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--button-main)] transition duration-200 group-hover:gap-3">
      查看详情
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>