---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
}

const { eyebrow, title, description, actionHref, actionLabel } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<div class="mb-8 flex flex-col gap-4 md:mb-10 md:flex-row md:items-end md:justify-between">
  <div class="space-y-3">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="font-display text-3xl font-semibold leading-tight text-[var(--text-main)] md:text-4xl">{title}</h2>
    {description && <p class="max-w-2xl text-base leading-8 text-[var(--text-muted)]">{description}</p>}
  </div>
  {actionHref && actionLabel && (
    <a href={`${baseUrl}${actionHref.replace(/^\//, "")}`} class="button-secondary shrink-0">
      <svg class="button-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7"></path>
        <path d="M9 7h8v8"></path>
      </svg>
      {actionLabel}
    </a>
  )}
</div>