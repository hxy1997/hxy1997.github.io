---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const baseUrl = import.meta.env.BASE_URL;
const toHref = (href: string) => `${baseUrl}${href.replace(/^\//, "")}`;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="sticky top-4 z-50">
  <div class="shell">
    <div class="panel rounded-[28px] border border-slate-200/80 px-4 py-3 dark:border-white/10">
      <div class="flex items-center justify-between gap-4">
        <a href={baseUrl} class="flex items-center gap-3 rounded-full px-2 py-1.5 text-sm font-semibold text-[var(--text-main)]">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[color:var(--button-main)]/12 font-display text-base text-[color:var(--button-main)]">Y</span>
          <span class="hidden sm:block">{siteConfig.name}</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          {siteConfig.nav.map((item) => (
            <a
              href={toHref(item.href)}
              class:list={[
                "rounded-full px-4 py-2 text-sm font-medium transition duration-200",
                isActive(item.href)
                  ? "bg-[color:var(--button-main)]/14 text-[color:var(--button-main)]"
                  : "text-[var(--text-muted)] hover:bg-white/70 hover:text-[var(--text-main)] dark:hover:bg-white/5",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="hidden md:block">
          <ThemeToggle />
        </div>

        <details class="relative md:hidden">
          <summary class="panel flex h-11 w-11 list-none items-center justify-center rounded-full border border-slate-200/80 text-[var(--text-main)] dark:border-white/10 [&::-webkit-details-marker]:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </summary>
          <div class="panel absolute right-0 mt-3 grid min-w-[220px] gap-2 rounded-[24px] border border-slate-200/80 p-3 dark:border-white/10">
            {siteConfig.nav.map((item) => (
              <a href={toHref(item.href)} class="rounded-2xl px-4 py-3 text-sm font-medium text-[var(--text-muted)] transition hover:bg-white/70 hover:text-[var(--text-main)] dark:hover:bg-white/5">
                {item.label}
              </a>
            ))}
            <div class="pt-2">
              <ThemeToggle class="w-full" />
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>