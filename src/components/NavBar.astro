---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const baseUrl = import.meta.env.BASE_URL;
const toHref = (href: string) => `${baseUrl}${href.replace(/^\//, "")}`;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="sticky top-4 z-50">
  <div class="shell">
    <div class="panel rounded-[30px] border border-[color:var(--panel-border)] px-4 py-3 md:px-5">
      <div class="flex items-center justify-between gap-4">
        <a href={baseUrl} class="flex items-center gap-3 rounded-full px-2 py-1.5 text-sm font-semibold text-[var(--text-main)]">
          <span class="flex h-10 w-10 items-center justify-center rounded-[16px] border border-black/10 bg-white/60 text-base text-[color:var(--button-main-hover)] shadow-[inset_0_1px_0_rgba(255,255,255,0.65)] dark:border-white/10 dark:bg-white/6">
            Y
          </span>
          <span class="hidden text-[15px] tracking-[0.02em] sm:block">{siteConfig.name}</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          {siteConfig.nav.map((item) => (
            <a
              href={toHref(item.href)}
              class:list={[
                "rounded-full px-4 py-2 text-sm font-medium transition duration-200",
                isActive(item.href)
                  ? "bg-[color:var(--button-main)]/14 text-[color:var(--button-main-hover)] shadow-[inset_0_1px_0_rgba(255,255,255,0.45)]"
                  : "text-[var(--text-muted)] hover:bg-black/[0.04] hover:text-[var(--text-main)] dark:hover:bg-white/[0.06]",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="hidden md:block">
          <ThemeToggle />
        </div>

        <details class="relative md:hidden">
          <summary class="panel flex h-11 w-11 list-none items-center justify-center rounded-full border border-[color:var(--panel-border)] text-[var(--text-main)] [&::-webkit-details-marker]:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </summary>
          <div class="panel absolute right-0 mt-3 grid min-w-[220px] gap-2 rounded-[24px] border border-[color:var(--panel-border)] p-3">
            {siteConfig.nav.map((item) => (
              <a href={toHref(item.href)} class="rounded-2xl px-4 py-3 text-sm font-medium text-[var(--text-muted)] transition hover:bg-black/[0.04] hover:text-[var(--text-main)] dark:hover:bg-white/[0.06]">
                {item.label}
              </a>
            ))}
            <div class="pt-2">
              <ThemeToggle class="w-full" />
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>