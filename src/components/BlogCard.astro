---
import { formatDate } from "../utils/format";

interface Props {
  post: import("astro:content").CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const href = `${baseUrl}blog/${post.slug}/`;
---

<article
  class:list={[
    "group panel rounded-[30px] border border-[color:var(--panel-border)] p-6 transition duration-200 hover:-translate-y-1 hover:border-[color:var(--button-main)] hover:shadow-lg",
    featured ? "panel-strong grid-frost min-h-[300px] justify-between p-7" : "relative h-full overflow-hidden",
  ]}
>
  {featured && (
    <>
      <div aria-hidden="true" class="pointer-events-none absolute -right-10 top-8 h-24 w-24 rounded-full bg-[color:var(--button-main)]/14 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute right-6 bottom-6 flex items-center gap-2 opacity-60">
        <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--button-main-hover)]"></span>
        <span class="h-px w-10 bg-[color:var(--button-main-hover)]/45"></span>
        <span class="h-2 w-2 rounded-full border border-[color:var(--button-main-hover)]/60"></span>
      </div>
    </>
  )}

  <div class="relative flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1 space-y-3">
      <p class="text-sm font-medium text-[var(--text-soft)]">{formatDate(post.data.pubDate)}</p>
      <h3 class:list={[
        "font-display text-[var(--text-main)] transition duration-200 group-hover:text-[color:var(--button-main-hover)]",
        featured ? "max-w-[12ch] text-[2rem] leading-[1.22]" : "text-2xl leading-snug",
      ]}>
        {post.data.title}
      </h3>
    </div>
    <span class="badge-pill">
      {post.data.tags[0] ?? "随笔"}
    </span>
  </div>

  <p class:list={[
    "relative mt-5 leading-8 text-[var(--text-muted)]",
    featured ? "max-w-md text-base" : "text-sm",
  ]}>
    {post.data.description}
  </p>

  <div class="relative mt-6 flex flex-wrap gap-2">
    {post.data.tags.slice(0, featured ? 3 : 2).map((tag) => (
      <span class="chip rounded-full">#{tag}</span>
    ))}
  </div>

  <a href={href} class="relative mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--button-main-hover)] transition duration-200 group-hover:gap-3">
    阅读文章
    <span aria-hidden="true">→</span>
  </a>
</article>