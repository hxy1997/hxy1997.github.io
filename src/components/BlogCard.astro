---
import { formatDate } from "../utils/format"; interface Props { post: import("astro:content").CollectionEntry<"blog">; featured?: boolean;
} const { post, featured = false } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const href = `${baseUrl}blog/${post.slug}/`;
--- <article class:list={[ "group panel rounded-[28px] border border-[color:var(--panel-border)] p-6 transition duration-200 hover:-translate-y-1 hover:border-[color:var(--button-main)] hover:shadow-lg ", featured ? "grid-frost min-h-[280px] justify-between p-7" : "h-full",
]}> <div class="flex items-start justify-between gap-4"> <div class="space-y-3"> <p class="text-sm font-medium text-[var(--text-soft)]">{formatDate(post.data.pubDate)}</p> <h3 class:list={[ "font-display text-[var(--text-main)] transition duration-200 group-hover:text-[color:var(--button-main)]", featured ? "text-2xl leading-tight" : "text-xl leading-snug", ]}>{post.data.title}</h3> </div> <span class="rounded-full border border-[color:var(--panel-border)] px-3 py-1 text-xs font-medium text-[var(--text-soft)] "> {post.data.tags[0] ?? "随笔"} </span> </div> <p class:list={[ "mt-5 leading-7 text-[var(--text-muted)]", featured ? "max-w-md text-base" : "text-sm", ]}>{post.data.description}</p> <div class="mt-6 flex flex-wrap gap-2"> {post.data.tags.slice(0, featured ? 3 : 2).map((tag) => ( <span class="chip rounded-full">#{tag}</span> ))} </div> <a href={href} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-[color:var(--button-main)] transition duration-200 group-hover:gap-3"> 阅读文章 <span aria-hidden="true">→</span> </a>
</article>